# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Settings → API no painel do Supabase). A anon key é pública por design;
# o RLS do banco (ver schema.sql) impede que um usuário acesse dados de outro.
# NUNCA coloque a service_role key aqui ou em qualquer código do frontend.

NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica
